# Copy this file to `.env` and fill in the values you need.
# `.env` is read by the harness (python-dotenv) and is git-ignored -- never
# commit real secrets.

# --- Telegram notifications (optional) --------------------------------------
# Enable with notifications.telegram.enabled: true in config.yaml.
# 1) Create a bot with @BotFather -> you get the token below.
# 2) Get your chat id (message the bot, then open
#    https://api.telegram.org/bot<token>/getUpdates and read chat.id,
#    or use @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional CLI credentials -----------------------------------------------
# Most CLIs use their own `login` command and DO NOT need these. Only set them
# if your CLI reads keys from the environment.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
